<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_export_format_title"
            android:textColor="#F5F5F5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#1F262C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dialog_private_key_title"
            android:textColor="#F5F5F5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrivateKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_transaction"
            android:padding="14dp"
            android:textColor="#A7ADB5"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:typeface="monospace" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCopyPrivate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:elevation="4dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/button_copy"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#1F262C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dialog_mnemonic_title"
            android:textColor="#F5F5F5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMnemonic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_transaction"
            android:padding="14dp"
            android:textColor="#A7ADB5"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:typeface="monospace" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCopyMnemonic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:elevation="4dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/button_copy"
            android:textAllCaps="false"
            android:textColor="#E2E5E9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_warning"
            android:padding="14dp"
            android:text="@string/export_warning"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>