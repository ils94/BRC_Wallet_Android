<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#16191D" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#25292E" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#292D33" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#444A52" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1D21" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#30343A" />
        </shape>
    </item>

</selector>